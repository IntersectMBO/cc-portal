    "@nestjs/typeorm": "^10.0.2",
    "@sendgrid/mail": "^8.1.1",
    "@types/diff": "^5.0.9",
    "@types/humps": "^2.0.6",
    "@types/morgan": "^1.9.7",
    "@types/multer": "^1.4.11",
    "axios": "^1.20.0",
    "blake2b": "^2.1.4",
    "blakejs": "^1.2.1",
