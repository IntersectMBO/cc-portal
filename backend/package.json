    "lodash": "^4.18.1",
    "minimatch@^9.0.0": "^9.0.7",
    "multer@^2.0.0": "^2.3.0",
    "picomatch@^4.0.0": "^4.0.4",
    "qs": "^6.16.0",
    "rollup": "4.62.3",
    "uuid@^11.0.0": "^11.1.1",
    "webpack": "$webpack"
  }
